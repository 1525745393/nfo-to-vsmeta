{
    "directory": "./videos",
    "poster_suffix": "-poster.jpg",
    "fanart_suffix": "-fanart.jpg",
    "video_extensions": [".mkv", ".mp4", ".rmvb", ".avi", ".wmv", ".ts"],
    "ignore_extensions": [".vsmeta", ".jpg", ".jpeg", ".nfo", ".srt", ".ass", ".ssa", ".png", ".db", ".log", ".tmp"],
    "delete_vsmeta": false,
    "update_stale_vsmeta": true,
    "max_workers": 4,
    "compress_image": true,
    "compress_kb": 200,
    "log_file": "process.log",
    "log_max_bytes": 1048576,
    "log_backup_count": 3,
    "studio_as_tagline": false,
    "parse_episode_from_trailing_digits": false
}
